APP_DOMAIN=organiza-contas.vps11931.panel.icontainer.cloud
# Desenvolvimento local (npm start). Docker define a origem HTTPS acima.
APP_ORIGIN=http://localhost:3000
# Obrigatória: gere com `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"`.
# Guarde somente no .env da máquina/VPS; perder esta chave impede a recuperação dos comprovantes.
ATTACHMENT_ENCRYPTION_KEY=
# Opcional: cliente OAuth Web do Google, sem Firebase.
# Callback: https://SEU_DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
