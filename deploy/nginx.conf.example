# Adicione ao proxy existente. Configure o certificado pelo painel/Certbot.
# Não substitua a configuração global do servidor.
server {
    listen 80;
    server_name organiza-contas.vps11931.panel.icontainer.cloud;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name organiza-contas.vps11931.panel.icontainer.cloud;
    ssl_certificate /CAMINHO/DO/CERTIFICADO/fullchain.pem;
    ssl_certificate_key /CAMINHO/DA/CHAVE/privkey.pem;
    client_max_body_size 11m;
    location / {
        proxy_pass http://127.0.0.1:3080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
